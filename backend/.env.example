# VoxEdge Phase 2 — Environment Variables
# Copy this file to .env and adjust values as needed.

# Database (SQLite path relative to backend/)
DATABASE_URL=sqlite:///./voxedge.db

# Vosk model directory (relative to project root)
VOSK_MODEL_PATH=../model

# Speaker verification
SIMILARITY_THRESHOLD=0.65

# Enrolled voice embedding
ENROLLED_VOICE_PATH=../enrolled_voice.npy

# Decision engine
INTENT_CONFIDENCE_THRESHOLD=0.6
CONTEXT_EXPIRY_SECONDS=120
MAX_CLARIFICATION_ATTEMPTS=2

# Emergency
EMERGENCY_AUTO_TIMEOUT_SECONDS=300

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
